---
export interface Props {
  title: string;
  description: string;
  href: string;
  icon: 'car' | 'used-car' | 'lingerie' | 'security';
  ctaText?: string;
}

const { title, description, href, icon, ctaText = 'Learn More' } = Astro.props;

const icons: Record<string, string> = {
  car: 'M14.976 0A.502.502 0 0014.5.5V2h-5V.5a.5.5 0 00-1 0V2h-2a.5.5 0 000 1h2v1.5a.5.5 0 001 0V3h5v1.5a.5.5 0 001 0V3h2.5a.5.5 0 000-1h-2.5V.5a.5.5 0 00-.524-.5zM4.5 5A2.5 2.5 0 002 7.5v7c0 .619.211 1.19.566 1.635l-.88.88a.5.5 0 10.707.707l.88-.88A2.48 2.48 0 004.5 17h7a2.48 2.48 0 001.227-.342l.88.88a.5.5 0 10.707-.707l-.88-.88A2.48 2.48 0 0014 14.5v-7A2.5 2.5 0 0011.5 5h-7zM3 7.5A1.5 1.5 0 014.5 6h7A1.5 1.5 0 0113 7.5v7a1.5 1.5 0 01-1.5 1.5h-7A1.5 1.5 0 013 14.5v-7zm2 .5a1 1 0 100 2 1 1 0 000-2zm5 0a1 1 0 100 2 1 1 0 000-2zm-5 4a1 1 0 100 2 1 1 0 000-2zm5 0a1 1 0 100 2 1 1 0 000-2z',
  'used-car': 'M19 17h2a1 1 0 001-1v-3a1 1 0 00-.29-.71l-2.71-2.71A1 1 0 0018.29 9H17V7a2 2 0 00-2-2H9a2 2 0 00-2 2v2H5.71a1 1 0 00-.71.29L2.29 12A1 1 0 002 13v3a1 1 0 001 1h2m5 1a2 2 0 100-4 2 2 0 000 4zm6 0a2 2 0 100-4 2 2 0 000 4zM5 17H3v2h2v-2zm14 0h2v2h-2v-2z',
  lingerie: 'M4 3h16a1 1 0 011 1v5a1 1 0 01-1 1H4a1 1 0 01-1-1V4a1 1 0 011-1zm1 2v3h14V5H5zm14 7H5a1 1 0 00-1 1v4a1 1 0 001 1h14a1 1 0 001-1v-4a1 1 0 00-1-1zM5 14h14v3H5v-3z',
  security: 'M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.56-3.18 8.82-7 9.94V3.18z',
};
---

<a
  href={href}
  class="group bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-200 overflow-hidden border border-gray-100 hover:border-accent/30 p-8"
>
  <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors">
    <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon] || icons.security} />
    </svg>
  </div>
  <h3 class="text-xl font-semibold text-primary mb-3 group-hover:text-accent transition-colors">{title}</h3>
  <p class="text-muted leading-relaxed mb-4">{description}</p>
  <span class="text-accent font-medium text-sm group-hover:underline">
    {ctaText} &rarr;
  </span>
</a>
