---
/**
 * ProductCardV2 — Reusable multilingual product card
 * 
 * Props:
 *   - category: 'cars' | 'textiles' | 'security' | 'supply-chain'
 *   - title: { en: string, ru: string, zh: string }
 *   - images: string[]
 *   - shortDescription: { en: string, ru: string, zh: string }
 *   - specifications?: Record<string, string>
 *   - moq?: string
 *   - destinationAvailability?: string[]
 *   - locale: Locale
 *   - verificationStatus: 'verified' | 'pending'
 *   - inquiryReference?: string
 *   - link?: string (optional link for the card)
 */
import type { Locale } from '@i18n/types';
import { t } from '@i18n/index';

export interface Props {
  category: 'cars' | 'textiles' | 'security' | 'supply-chain';
  title: { en: string; ru: string; zh: string };
  images: string[];
  shortDescription: { en: string; ru: string; zh: string };
  specifications?: Record<string, string>;
  moq?: string;
  destinationAvailability?: string[];
  locale: Locale;
  verificationStatus: 'verified' | 'pending';
  inquiryReference?: string;
  link?: string;
  badge?: { en: string; ru: string; zh: string };
}

const {
  category,
  title,
  images,
  shortDescription,
  specifications,
  moq,
  destinationAvailability,
  locale,
  verificationStatus,
  inquiryReference,
  link,
  badge,
} = Astro.props;

const displayName = title[locale] || title.en;
const displayDesc = shortDescription[locale] || shortDescription.en;
const displayBadge = badge ? (badge[locale] || badge.en) : '';
const requestQuoteText = t('common.requestQuote', locale);
const verifiedLabel = t('common.verified', locale);
const pendingLabel = t('common.pending', locale);
const moqLabel = t('common.moq', locale);
const destLabel = t('common.destinationAvailability', locale);

const categoryLabels: Record<string, { en: string; ru: string; zh: string }> = {
  'cars': { en: 'Vehicle Export', ru: 'Экспорт авто', zh: '汽车出口' },
  'textiles': { en: 'Textiles & OEM', ru: 'Текстиль и OEM', zh: '纺织品与OEM' },
  'security': { en: 'Security Equipment', ru: 'Оборудование безопасности', zh: '安防设备' },
  'supply-chain': { en: 'Supply Chain', ru: 'Цепочка поставок', zh: '供应链' },
};

const categoryLabel = categoryLabels[category];
const displayCategoryLabel = categoryLabel ? (categoryLabel[locale] || categoryLabel.en) : category;
---

<article
  class={`group flex flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-white transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-[var(--color-primary)]/10 ${link ? 'cursor-pointer' : ''}`}
>
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden bg-[var(--color-bg)]">
    {images.length > 0 ? (
      <img
        src={images[0]}
        alt={displayName}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full items-center justify-center bg-gray-100 text-gray-400">
        <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
    <!-- Category Badge -->
    <span class="absolute left-3 top-3 rounded-full bg-[var(--color-primary)]/90 px-2.5 py-1 text-[11px] font-semibold text-white">
      {displayCategoryLabel}
    </span>
    <!-- Custom Badge -->
    {displayBadge && (
      <span class="absolute right-3 top-3 rounded-full bg-[var(--color-accent)] px-2.5 py-1 text-[11px] font-semibold text-[var(--color-bg-dark)]">
        {displayBadge}
      </span>
    )}
    <!-- Verification Status -->
    <span class={`absolute bottom-3 left-3 rounded-full px-2.5 py-1 text-[10px] font-semibold ${
      verificationStatus === 'verified'
        ? 'bg-green-100 text-green-700'
        : 'bg-yellow-100 text-yellow-700'
    }`}>
      {verificationStatus === 'verified' ? verifiedLabel : pendingLabel}
    </span>
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-bold font-[var(--font-heading)] text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors">
      {displayName}
    </h3>
    <p class="mt-2 text-sm text-gray-500 line-clamp-2">{displayDesc}</p>

    <!-- Specifications (compact) -->
    {specifications && Object.keys(specifications).length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {Object.entries(specifications).slice(0, 3).map(([key, value]) => (
          <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600">
            {key}: {value}
          </span>
        ))}
      </div>
    )}

    <!-- MOQ -->
    {moq && (
      <div class="mt-2 text-xs text-gray-500">
        <span class="font-semibold">{moqLabel}:</span> {moq}
      </div>
    )}

    <!-- Destination Availability -->
    {destinationAvailability && destinationAvailability.length > 0 && (
      <div class="mt-1 text-xs text-gray-500">
        <span class="font-semibold">{destLabel}:</span> {destinationAvailability.slice(0, 3).join(', ')}
        {destinationAvailability.length > 3 ? ` +${destinationAvailability.length - 3}` : ''}
      </div>
    )}

    <!-- Inquiry Reference -->
    {inquiryReference && (
      <div class="mt-1 text-[11px] text-gray-400">Ref: {inquiryReference}</div>
    )}

    <!-- CTA -->
    <div class="mt-auto pt-4">
      <span class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)] transition-colors group-hover:text-[var(--color-accent)]">
        {requestQuoteText}
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    </div>
  </div>
</article>
