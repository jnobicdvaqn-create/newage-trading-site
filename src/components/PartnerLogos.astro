---
import type { Locale } from '@i18n/types';
import { t } from '@i18n/index';

export interface Props {
  lang?: Locale;
  title?: string;
}

const {
  lang = 'en' as Locale,
  title = t('home.partnersTitle', lang),
} = Astro.props;

// Partner brands we work with
const partners = [
  { name: 'BYD', type: 'brand' },
  { name: 'Geely', type: 'brand' },
  { name: 'Great Wall', type: 'brand' },
  { name: 'Toyota', type: 'brand' },
  { name: 'Hikvision', type: 'brand' },
  { name: 'Dahua', type: 'brand' },
];
---

<section class="bg-[var(--color-bg)] py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-center text-2xl font-bold font-[var(--font-heading)] text-[var(--color-text)] mb-10">
      {title}
    </h2>

    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
      {partners.map((partner) => (
        <div class="group flex items-center justify-center rounded-lg bg-white px-6 py-4 shadow-sm transition-all hover:shadow-md">
          {partner.type === 'cert' ? (
            <!-- Certification badge -->
            <div class="flex items-center gap-2 text-[var(--color-text-light)] transition-colors group-hover:text-[var(--color-primary)]">
              <svg class="h-6 w-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span class="font-semibold text-sm">{partner.name}</span>
            </div>
          ) : (
            <!-- Brand name -->
            <span class="text-xl font-bold text-[var(--color-text-light)] transition-colors group-hover:text-[var(--color-primary)]">
              {partner.name}
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
