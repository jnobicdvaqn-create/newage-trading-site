---
import type { Locale } from '@i18n/types';
import { t } from '@i18n/index';
import { contact } from '@config/contact';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<footer class="bg-[var(--color-bg-dark)] text-gray-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--color-accent)] text-sm font-bold text-[var(--color-bg-dark)]">
            NT
          </span>
          <span class="text-lg font-bold text-white">
            NewAge <span class="font-light">Trading</span>
          </span>
        </div>
        <p class="text-sm leading-relaxed text-gray-400">
          {t('site.description', lang)}
        </p>
        <!-- Social Icons -->
        <div class="flex gap-3 pt-2">
          <a
            href={`https://wa.me/${contact.whatsappNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-700 text-gray-300 transition-colors hover:bg-green-600 hover:text-white"
            aria-label="WhatsApp"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <a
            href={contact.telegramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-700 text-gray-300 transition-colors hover:bg-blue-500 hover:text-white"
            aria-label="Telegram"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.976 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </a>
          <a
            href={`mailto:${contact.email}`}
            class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-700 text-gray-300 transition-colors hover:bg-[var(--color-accent)] hover:text-[var(--color-bg-dark)]"
            aria-label="Email"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">{t('common.quickLinks', lang)}</h3>
        <ul class="space-y-2.5 text-sm">
          {(['nav.cars', 'nav.usedCars', 'nav.lingerie', 'nav.security', 'nav.about', 'nav.blog', 'nav.contact'] as const).map((key) => (
            <li>
              <a
                href={`/${lang}/${key === 'nav.cars' ? 'cars' : key === 'nav.usedCars' ? 'used-cars' : key === 'nav.lingerie' ? 'lingerie' : key === 'nav.security' ? 'security' : key === 'nav.about' ? 'about' : key === 'nav.blog' ? 'blog' : 'contact'}/`}
                class="text-gray-400 transition-colors hover:text-[var(--color-accent)]"
              >
                {t(key, lang)}
              </a>
            </li>
          ))}
          <li><a href={`/${lang}/privacy/`} class="text-gray-400 transition-colors hover:text-[var(--color-accent)]">{t('nav.privacy', lang)}</a></li>
          <li><a href={`/${lang}/terms/`} class="text-gray-400 transition-colors hover:text-[var(--color-accent)]">{t('nav.terms', lang)}</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">{t('common.contactInfo', lang)}</h3>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`https://wa.me/${contact.whatsappNumber}`} class="transition-colors hover:text-[var(--color-accent)]">{contact.whatsappDisplay}</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.976 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            <a href={contact.telegramUrl} class="transition-colors hover:text-[var(--color-accent)]">{contact.telegram}</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${contact.email}`} class="break-all transition-colors hover:text-[var(--color-accent)]">
              {contact.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{t('contact.addressLine', lang)}</span>
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">{t('footer.newsletter', lang)}</h3>
        <form class="flex flex-col gap-2">
          <input
            type="email"
            placeholder={t('footer.newsletterPlaceholder', lang)}
            class="rounded-lg border border-gray-600 bg-gray-800 px-3 py-2.5 text-sm text-white placeholder-gray-400 transition-colors focus:border-[var(--color-accent)] focus:outline-none"
          />
          <button
            type="submit"
            class="rounded-lg bg-[var(--color-accent)] px-4 py-2.5 text-sm font-semibold text-[var(--color-bg-dark)] transition-colors hover:bg-[var(--color-accent-light)]"
          >
            {t('footer.newsletterCTA', lang)}
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-5 sm:flex-row sm:px-6 lg:px-8">
      <p class="text-xs text-gray-500">{t('footer.rights', lang)}</p>
      <div class="flex gap-4 text-xs text-gray-500">
        <a href={`/${lang}/privacy/`} class="transition-colors hover:text-[var(--color-accent)]">{t('footer.privacy', lang)}</a>
        <a href={`/${lang}/terms/`} class="transition-colors hover:text-[var(--color-accent)]">{t('footer.terms', lang)}</a>
      </div>
    </div>
  </div>
</footer>
