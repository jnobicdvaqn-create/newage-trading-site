---
import { t } from '@i18n/index';
import type { Locale } from '@i18n/types';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  price?: string;
  link?: string;
  badge?: string;
  features?: string[];
  // Support passing a product object directly
  product?: Record<string, unknown>;
  href?: string;
  lang?: Locale;
}

const props = Astro.props;
const lang = props.lang as Locale | undefined;

// Extract from product object if provided, otherwise use direct props
const product = props.product as Record<string, unknown> | undefined;

// Language-aware field extraction
const title = props.title || 
  (lang && product?.[`name${lang.charAt(0).toUpperCase() + lang.slice(1)}` as string] as string) || 
  (product?.name as string) || '';

const description = props.description || 
  (lang && product?.[`description${lang.charAt(0).toUpperCase() + lang.slice(1)}` as string] as string) || 
  (product?.description as string) || '';

const rawImage = props.image || (product?.image as string) || '';
const image = rawImage ? `${rawImage}?v=20260514c` : '';
const price = props.price || (product?.price as string) || '';
const link = props.href || props.link || '#';

const badge = props.badge || (product?.category as string) || '';
const features = props.features || 
  (lang && product?.[`highlights${lang.charAt(0).toUpperCase() + lang.slice(1)}` as string] as string[]) || 
  (product?.highlights as string[]) || undefined;

// Localized "View Details" label
const viewDetails = lang ? t('common.viewDetails', lang) : 'View Details';
const moreLabel = lang ? t('common.more', lang) : 'more';
---

<a
  href={link}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-white transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-[var(--color-primary)]/10"
>
  <!-- Image Container -->
  <div class="relative aspect-[4/3] overflow-hidden bg-[var(--color-bg)]">
    {image ? (
      <img
        src={image}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full items-center justify-center">
        <svg class="h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}

    <!-- Badge -->
    {badge && (
      <span class="absolute left-3 top-3 rounded-full bg-[var(--color-accent)] px-3 py-1 text-xs font-semibold text-[var(--color-bg-dark)]">
        {badge}
      </span>
    )}

    <!-- Price overlay at bottom of image -->
    {price && (
      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4 pt-8">
        <span class="text-lg font-bold text-white">{price}</span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-bold font-[var(--font-heading)] text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors">
      {title}
    </h3>

    {description && (
      <p class="mt-2 text-sm text-[var(--color-text-light)] line-clamp-2">
        {description}
      </p>
    )}

    <!-- Features list -->
    {features && features.length > 0 && (
      <ul class="mt-3 space-y-1.5">
        {features.slice(0, 3).map((feature) => (
          <li class="flex items-start gap-2 text-xs text-[var(--color-text-light)]">
            <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            {feature}
          </li>
        ))}
        {features.length > 3 && (
          <li class="text-xs font-medium text-[var(--color-primary)]">
            +{features.length - 3} {moreLabel}
          </li>
        )}
      </ul>
    )}

    <!-- View Details link -->
    <div class="mt-auto pt-4">
      <span class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)] transition-colors group-hover:text-[var(--color-accent)]">
        {viewDetails}
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    </div>
  </div>
</a>
