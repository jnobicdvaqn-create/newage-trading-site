---
/**
 * QuoteForm.astro — Multi-language quote request form.
 *
 * Props:
 *   locale: 'en' | 'ru' | 'zh'
 *   formMode: 'prototype' | 'email' | 'feishu' | 'email_feishu'
 *   pageSlug: for analytics / tracking
 */
import { tp, type Locale } from '@i18n/index';
import { FORM_MODE, FORM_ENDPOINTS } from '@config/pricing';

interface Props {
  locale?: Locale;
  formMode?: 'prototype' | 'email' | 'feishu' | 'email_feishu';
  pageSlug?: string;
  className?: string;
}

const {
  locale = 'en',
  formMode = FORM_MODE,
  pageSlug = 'default',
  className = '',
} = Astro.props;

const formTitle = tp('formTitle', locale);
const formName = tp('formName', locale);
const formNamePh = tp('formNamePlaceholder', locale);
const formEmail = tp('formEmail', locale);
const formEmailPh = tp('formEmailPlaceholder', locale);
const formPhone = tp('formPhone', locale);
const formPhonePh = tp('formPhonePlaceholder', locale);
const formMessage = tp('formMessage', locale);
const formMessagePh = tp('formMessagePlaceholder', locale);
const formSubmit = tp('formSubmit', locale);
const formSubmitting = tp('formSubmitting', locale);
const formSuccess = tp('formSuccess', locale);
const formError = tp('formError', locale);

const formAction =
  formMode !== 'prototype' && FORM_ENDPOINTS.email ? FORM_ENDPOINTS.email : '#';
---

<section id="quote-form" class={`max-w-2xl mx-auto ${className}`}>
  <h2 class="text-2xl font-bold text-[#0a1628] mb-6 text-center">{formTitle}</h2>

  <form
    id="quote-request-form"
    action={formAction}
    method="POST"
    class="space-y-5 bg-white rounded-2xl shadow-lg p-6 md:p-8"
  >
    <!-- Hidden fields -->
    <input type="hidden" name="_subject" value={`New Inquiry from ${pageSlug}`} />
    <input type="hidden" name="_next" value="/" />
    <input type="hidden" name="page_slug" value={pageSlug} />
    <input type="hidden" name="language" value={locale} />

    <!-- Name -->
    <div>
      <label for="qf-name" class="block text-sm font-medium text-gray-700 mb-1">{formName}</label>
      <input
        id="qf-name"
        name="name"
        type="text"
        required
        placeholder={formNamePh}
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#c9a84c] focus:border-[#c9a84c] outline-none"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="qf-email" class="block text-sm font-medium text-gray-700 mb-1">{formEmail}</label>
      <input
        id="qf-email"
        name="email"
        type="email"
        required
        placeholder={formEmailPh}
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#c9a84c] focus:border-[#c9a84c] outline-none"
      />
    </div>

    <!-- Phone -->
    <div>
      <label for="qf-phone" class="block text-sm font-medium text-gray-700 mb-1">{formPhone}</label>
      <input
        id="qf-phone"
        name="phone"
        type="tel"
        placeholder={formPhonePh}
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#c9a84c] focus:border-[#c9a84c] outline-none"
      />
    </div>

    <!-- Message -->
    <div>
      <label for="qf-message" class="block text-sm font-medium text-gray-700 mb-1">{formMessage}</label>
      <textarea
        id="qf-message"
        name="message"
        rows={4}
        required
        placeholder={formMessagePh}
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#c9a84c] focus:border-[#c9a84c] outline-none resize-none"
      ></textarea>
    </div>

    <!-- Submit -->
    <button
      type="submit"
      id="qf-submit"
      class="w-full px-6 py-3 bg-[#c9a84c] text-[#0a1628] font-semibold rounded-xl hover:bg-[#e2c767] transition-colors disabled:opacity-50"
    >
      {formSubmit}
    </button>

    <!-- Status messages -->
    <div id="qf-success" class="hidden p-4 bg-green-50 text-green-800 rounded-lg text-sm"></div>
    <div id="qf-error" class="hidden p-4 bg-red-50 text-red-800 rounded-lg text-sm"></div>
  </form>
</section>

<script>
  const form = document.getElementById('quote-request-form') as HTMLFormElement;
  const successEl = document.getElementById('qf-success') as HTMLDivElement;
  const errorEl = document.getElementById('qf-error') as HTMLDivElement;
  const submitBtn = document.getElementById('qf-submit') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    const mode = (form.dataset.formMode as string) || 'prototype';

    if (mode === 'prototype') {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = '...';

      // Simulate sending
      await new Promise((r) => setTimeout(r, 800));

      successEl.classList.remove('hidden');
      form.reset();
      submitBtn.disabled = false;
      return;
    }

    // For non-prototype modes, let the form submit naturally (FormSubmit.co handles redirect)
  });
</script>
