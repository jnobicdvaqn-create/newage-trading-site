---
import type { Locale } from '@i18n/types';
import { t } from '@i18n/index';
import { LOCALES } from '@i18n/locales';

export interface Props {
  lang: Locale;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;

const navItems = [
  { key: 'nav.home', path: `/${lang}/` },
  { key: 'nav.cars', path: `/${lang}/cars/` },
  { key: 'nav.usedCars', path: `/${lang}/used-cars/` },
  { key: 'nav.lingerie', path: `/${lang}/lingerie/` },
  { key: 'nav.security', path: `/${lang}/security/` },
  { key: 'nav.about', path: `/${lang}/about/` },
  { key: 'nav.blog', path: `/${lang}/blog/` },
  { key: 'nav.contact', path: `/${lang}/contact/` },
];

const localeNames: Record<Locale, string> = {
  en: 'EN',
  ru: 'RU',
  zh: '中文',
};

const isActive = (href: string): boolean => {
  if (href === `/${lang}/`) return currentPath === `/${lang}/`;
  return currentPath.startsWith(href);
};
---

<!-- WhatsApp Floating Button -->
<a
  href="https://wa.me/8617072783745"
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-green-500 text-white shadow-lg transition-transform hover:scale-110 hover:shadow-xl"
  aria-label="WhatsApp"
>
  <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
  </svg>
</a>

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href={`/${lang}/`} class="flex items-center gap-2">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--color-primary)] text-sm font-bold text-white">
        NT
      </span>
      <span class="hidden text-lg font-bold tracking-tight text-[var(--color-primary)] sm:inline">
        NewAge <span class="font-light">Trading</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-1 lg:flex">
      {navItems.map((item) => (
        <a
          href={item.path}
          class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
            isActive(item.path)
              ? 'bg-[var(--color-primary)] text-white'
              : 'text-gray-700 hover:bg-[var(--color-primary)]/10 hover:text-[var(--color-primary)]'
          }`}
        >
          {t(item.key, lang)}
        </a>
      ))}
    </nav>

    <!-- Right: Language Switcher + Mobile Toggle -->
    <div class="flex items-center gap-3">
      <div class="flex overflow-hidden rounded-lg border border-gray-200 text-xs font-medium">
        {LOCALES.map((l) => {
          const lPath = currentPath.replace(/^\/[a-z]{2}/, `/${l}`);
          return l === lang ? (
            <span class="bg-[var(--color-primary)] px-2.5 py-1.5 text-white">{localeNames[l]}</span>
          ) : (
            <a
              href={lPath}
              class="px-2.5 py-1.5 text-gray-500 transition-colors hover:bg-gray-100"
            >
              {localeNames[l]}
            </a>
          );
        })}
      </div>

      <!-- Mobile Hamburger -->
      <button id="mobile-toggle" class="flex h-9 w-9 items-center justify-center rounded-lg text-gray-700 transition-colors hover:bg-gray-100 lg:hidden" aria-label="Toggle menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-overlay" class="fixed inset-0 z-50 hidden bg-black/40 lg:hidden"></div>

<!-- Mobile Menu Panel -->
<nav
  id="mobile-panel"
  class="fixed left-0 top-0 z-50 flex h-full w-72 -translate-x-full flex-col bg-white shadow-xl transition-transform duration-300 lg:hidden"
>
  <div class="flex h-16 items-center justify-between border-b border-gray-200 px-5">
    <span class="text-lg font-bold text-[var(--color-primary)]">Menu</span>
    <button id="mobile-close" class="flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:bg-gray-100">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
    {navItems.map((item) => (
      <a
        href={item.path}
        class={`flex items-center rounded-lg px-4 py-3 text-sm font-medium transition-colors ${
          isActive(item.path)
            ? 'bg-[var(--color-primary)] text-white'
            : 'text-gray-700 hover:bg-[var(--color-primary)]/10 hover:text-[var(--color-primary)]'
        }`}
      >
        {t(item.key, lang)}
      </a>
    ))}
  </div>
  <!-- Mobile Language Switcher -->
  <div class="border-t border-gray-200 px-5 py-4">
    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-gray-400">
      {t('common.language', lang)}
    </p>
    <div class="flex gap-2">
      {LOCALES.map((l) => {
        const lPath = currentPath.replace(/^\/[a-z]{2}/, `/${l}`);
        return l === lang ? (
          <span class="flex-1 rounded-lg bg-[var(--color-primary)] px-3 py-2 text-center text-sm font-medium text-white">
            {localeNames[l]}
          </span>
        ) : (
          <a
            href={lPath}
            class="flex-1 rounded-lg border border-gray-200 px-3 py-2 text-center text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100"
          >
            {localeNames[l]}
          </a>
        );
      })}
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('mobile-toggle');
    const close = document.getElementById('mobile-close');
    const panel = document.getElementById('mobile-panel');
    const overlay = document.getElementById('mobile-overlay');

    if (toggle && panel && overlay && close) {
      const open = () => {
        panel.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };
      const closeMenu = () => {
        panel.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      };
      toggle.addEventListener('click', open);
      close.addEventListener('click', closeMenu);
      overlay.addEventListener('click', closeMenu);
      panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    }
  });
</script>
