---
import type { Locale } from '@i18n/types';
import { t } from '@i18n/index';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
  lang: Locale;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;

const navItems = [
  { key: 'nav.vehicles', path: `/${lang}/vehicles/` },
  { key: 'nav.textiles', path: `/${lang}/textiles/` },
  { key: 'nav.supplyChain', path: `/${lang}/supply-chain/` },
  { key: 'nav.insights', path: `/${lang}/insights/` },
  { key: 'nav.about', path: `/${lang}/about/` },
  { key: 'nav.contact', path: `/${lang}/contact/` },
];

const moreItems = [
  { key: 'nav.cars', path: `/${lang}/cars/` },
  { key: 'nav.usedCars', path: `/${lang}/used-cars/` },
  { key: 'nav.security', path: `/${lang}/security/` },
  { key: 'nav.lingerie', path: `/${lang}/lingerie/` },
];

const isActive = (href: string): boolean => {
  if (href === `/${lang}/`) return currentPath === `/${lang}/`;
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href={`/${lang}/`} class="flex items-center gap-2">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--color-primary)] text-sm font-bold text-white">
        NT
      </span>
      <span class="hidden text-lg font-bold tracking-tight text-[var(--color-primary)] sm:inline">
        YunBao <span class="font-light">International Trading</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-1 lg:flex">
      {navItems.map((item) => (
        <a
          href={item.path}
          class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
            isActive(item.path)
              ? 'bg-[var(--color-primary)] text-white'
              : 'text-gray-700 hover:bg-[var(--color-primary)]/10 hover:text-[var(--color-primary)]'
          }`}
        >
          {t(item.key, lang)}
        </a>
      ))}
      <!-- More Dropdown -->
      <div class="relative" id="more-dropdown">
        <button
          class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-[var(--color-primary)]/10 hover:text-[var(--color-primary)]"
          id="more-btn"
          aria-expanded="false"
          aria-haspopup="true"
        >
          {t('nav.more', lang)}
          <svg class="inline-block h-4 w-4 ml-1 -mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          class="absolute right-0 top-full z-50 mt-1 hidden min-w-[200px] rounded-lg border border-gray-200 bg-white py-2 shadow-lg"
          id="more-menu"
        >
          {moreItems.map((item) => (
            <a
              href={item.path}
              class={`block px-4 py-2.5 text-sm font-medium transition-colors ${
                isActive(item.path)
                  ? 'bg-[var(--color-primary)]/10 text-[var(--color-primary)]'
                  : 'text-gray-700 hover:bg-[var(--color-primary)]/10 hover:text-[var(--color-primary)]'
              }`}
            >
              {t(item.key, lang)}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Right: Language Switcher + Mobile Toggle -->
    <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} />

      <!-- Mobile Hamburger -->
      <button id="mobile-toggle" class="flex h-9 w-9 items-center justify-center rounded-lg text-gray-700 transition-colors hover:bg-gray-100 lg:hidden" aria-label="Toggle menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-overlay" class="fixed inset-0 z-50 hidden bg-black/40 lg:hidden"></div>

<!-- Mobile Menu Panel -->
<nav
  id="mobile-panel"
  class="fixed left-0 top-0 z-50 flex h-full w-72 -translate-x-full flex-col bg-white shadow-xl transition-transform duration-300 lg:hidden"
>
  <div class="flex h-16 items-center justify-between border-b border-gray-200 px-5">
    <span class="text-lg font-bold text-[var(--color-primary)]">Menu</span>
    <button id="mobile-close" class="flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:bg-gray-100">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
    {navItems.map((item) => (
      <a
        href={item.path}
        class={`flex items-center rounded-lg px-4 py-3 text-sm font-medium transition-colors ${
          isActive(item.path)
            ? 'bg-[var(--color-primary)] text-white'
            : 'text-gray-700 hover:bg-[var(--color-primary)]/10 hover:text-[var(--color-primary)]'
        }`}
      >
        {t(item.key, lang)}
      </a>
    ))}
    <div class="border-t border-gray-100 my-2"></div>
    <p class="px-4 py-1 text-xs font-semibold uppercase tracking-wider text-gray-400">{t('nav.more', lang)}</p>
    {moreItems.map((item) => (
      <a
        href={item.path}
        class={`flex items-center rounded-lg px-4 py-3 text-sm font-medium transition-colors ${
          isActive(item.path)
            ? 'bg-[var(--color-primary)] text-white'
            : 'text-gray-700 hover:bg-[var(--color-primary)]/10 hover:text-[var(--color-primary)]'
        }`}
      >
        {t(item.key, lang)}
      </a>
    ))}
  </div>
  <!-- Mobile Language Switcher -->
  <div class="border-t border-gray-200 px-5 py-4">
    <LanguageSwitcher lang={lang} className="w-full" />
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile menu
    const toggle = document.getElementById('mobile-toggle');
    const close = document.getElementById('mobile-close');
    const panel = document.getElementById('mobile-panel');
    const overlay = document.getElementById('mobile-overlay');

    if (toggle && panel && overlay && close) {
      const open = () => {
        panel.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };
      const closeMenu = () => {
        panel.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      };
      toggle.addEventListener('click', open);
      close.addEventListener('click', closeMenu);
      overlay.addEventListener('click', closeMenu);
      panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    }

    // More dropdown
    const moreBtn = document.getElementById('more-btn');
    const moreMenu = document.getElementById('more-menu');
    if (moreBtn && moreMenu) {
      moreBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const expanded = moreBtn.getAttribute('aria-expanded') === 'true';
        moreBtn.setAttribute('aria-expanded', String(!expanded));
        moreMenu.classList.toggle('hidden');
      });
      document.addEventListener('click', () => {
        moreBtn.setAttribute('aria-expanded', 'false');
        moreMenu.classList.add('hidden');
      });
      moreMenu.addEventListener('click', (e) => e.stopPropagation());
    }
  });
</script>
