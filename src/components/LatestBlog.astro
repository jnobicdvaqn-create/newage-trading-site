---
import type { Locale } from '@i18n/types';
import { t } from '@i18n/index';

export interface Props {
  lang?: Locale;
  title?: string;
  subtitle?: string;
}

const {
  lang = 'en' as Locale,
  title = t('home.blogTitle', lang),
  subtitle = t('home.blogSubtitle', lang),
} = Astro.props;

// Latest blog posts with cover images
const posts = [
  {
    image: '/images/blog/ev-export-guide.jpg',
    date: '2026-05-10',
    category: { en: 'Car Export', ru: 'Автоэкспорт', zh: '汽车出口' },
    title: {
      en: 'Complete Guide to Exporting Chinese EVs in 2026',
      ru: 'Полное руководство по экспорту китайских электромобилей в 2026 году',
      zh: '2026年中国电动汽车出口完全指南',
    },
    excerpt: {
      en: 'Everything you need to know about importing electric vehicles from China — regulations, costs, shipping.',
      ru: 'Все, что нужно знать об импорте электромобилей из Китая — правила, стоимость, доставка.',
      zh: '从中国进口电动汽车所需了解的一切 — 法规、成本、运输。',
    },
    link: `/${lang}/blog/china-ev-export-guide-2026/`,
  },
  {
    image: '/images/blog/lingerie-oem.jpg',
    date: '2026-05-08',
    category: { en: 'Lingerie OEM', ru: 'Белье OEM', zh: '内衣OEM' },
    title: {
      en: 'Lingerie OEM from China: How to Source at Competitive Prices',
      ru: 'OEM нижнего белья из Китая: как найти производителей',
      zh: '中国内衣OEM：如何以有竞争力的价格采购',
    },
    excerpt: {
      en: 'A practical guide to finding reliable OEM manufacturers in China\'s lingerie industry.',
      ru: 'Практическое руководство по поиску надежных OEM-производителей в Китае.',
      zh: '在中国内衣行业寻找可靠OEM制造商的实用指南。',
    },
    link: `/${lang}/blog/lingerie-oem-manufacturing-guide/`,
  },
];

const readMoreText = t('common.readMore', lang);
---

<section class="container-section bg-[var(--color-bg)]">
  <div class="text-center mb-12">
    <h2 class="section-title mb-4">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {posts.map((post) => (
      <a
        href={post.link}
        class="group flex flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-white transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-[var(--color-primary)]/10"
      >
        <!-- 封面图 -->
        <div class="relative h-48 overflow-hidden">
          <img
            src={post.image}
            alt={post.title[lang] || post.title.en}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
        </div>

        <!-- 内容 -->
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="rounded-full bg-[var(--color-accent)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-accent)]">
              {post.category[lang] || post.category.en}
            </span>
            <span class="text-xs text-[var(--color-text-light)]">{post.date}</span>
          </div>
          <h3 class="text-lg font-bold font-[var(--font-heading)] text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors">
            {post.title[lang] || post.title.en}
          </h3>
          <p class="mt-2 text-sm text-[var(--color-text-light)] line-clamp-2">
            {post.excerpt[lang] || post.excerpt.en}
          </p>
          <div class="mt-auto pt-4">
            <span class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)] transition-colors group-hover:text-[var(--color-accent)]">
              {readMoreText}
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
