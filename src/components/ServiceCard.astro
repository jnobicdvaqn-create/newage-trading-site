---
export interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  ctaText?: string;
}

const { title, description, href, image, imageAlt, ctaText = 'Learn More' } = Astro.props;
---

<a
  href={href}
  class="group bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-200 overflow-hidden border border-gray-100 hover:border-accent/30"
>
  <!-- 业务图片 -->
  <div class="relative h-48 overflow-hidden">
    <img
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
  </div>
  <!-- 文字内容 -->
  <div class="p-6">
    <h3 class="text-xl font-semibold text-primary mb-3 group-hover:text-accent transition-colors">{title}</h3>
    <p class="text-muted leading-relaxed mb-4">{description}</p>
    <span class="text-accent font-medium text-sm group-hover:underline">
      {ctaText} &rarr;
    </span>
  </div>
</a>
