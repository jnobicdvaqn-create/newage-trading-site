---
import type { Locale } from '@i18n/types';
import { t } from '@i18n/index';
import { contact } from '@config/contact';

export interface Props {
  lang?: Locale;
  title?: string;
  description?: string;
}

const {
  lang = 'en' as Locale,
  title = t('common.ctaTitle', lang),
  description = t('common.ctaDesc', lang),
} = Astro.props;
---

<section class="bg-[var(--color-primary)] py-20">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-3xl font-bold font-[var(--font-heading)] text-white sm:text-4xl">
      {title}
    </h2>
    <p class="mt-4 text-lg text-gray-300">
      {description}
    </p>

    <!-- Contact Channels -->
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <!-- WhatsApp -->
      <a
        href={`https://wa.me/${contact.whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex w-full items-center justify-center gap-3 rounded-lg bg-green-500 px-8 py-4 text-white transition-all hover:bg-green-400 hover:shadow-lg hover:shadow-green-500/30 sm:w-auto"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="text-left">
          <span class="block text-xs opacity-80">{t('contact.whatsapp', lang)}</span>
          <span class="block text-sm font-semibold">{contact.whatsappDisplay}</span>
        </span>
      </a>

      <!-- Divider -->
      <span class="text-sm font-medium uppercase tracking-wider text-gray-400">{lang === 'ru' ? 'или' : lang === 'zh' ? '或' : 'or'}</span>

      <!-- Telegram -->
      <a
        href="https://t.me/richzhu001"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex w-full items-center justify-center gap-3 rounded-lg bg-blue-500 px-8 py-4 text-white transition-all hover:bg-blue-400 hover:shadow-lg hover:shadow-blue-500/30 sm:w-auto"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.976 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        <span class="text-left">
          <span class="block text-xs opacity-80">{t('contact.telegram', lang)}</span>
          <span class="block text-sm font-semibold">@richzhu001</span>
        </span>
      </a>

      <!-- Email -->
      <a
        href="mailto:felipeche01manager@YUNBSAOtrade.onmicrosoft.com"
        class="group inline-flex w-full items-center justify-center gap-3 rounded-lg bg-[var(--color-accent)] px-8 py-4 text-[var(--color-bg-dark)] transition-all hover:bg-[var(--color-accent-light)] hover:shadow-lg hover:shadow-[var(--color-accent)]/30 sm:w-auto"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <span class="text-left">
          <span class="block text-xs opacity-80">{t('contact.email', lang)}</span>
          <span class="block text-sm font-semibold">{lang === 'ru' ? 'Отправить' : lang === 'zh' ? '发送邮件' : 'Send Email'}</span>
        </span>
      </a>
    </div>
  </div>
</section>
