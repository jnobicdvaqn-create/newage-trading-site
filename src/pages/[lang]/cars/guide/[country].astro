---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import CTASection from '@components/CTASection.astro';
import type { Locale } from '@i18n/types';
import countries from '@data/countries.json';
import cars from '@data/cars.json';
import { tData, label } from '@lib/i18n-data';

export function getStaticPaths() {
  const langs: Locale[] = ['en', 'ru', 'zh'];
  return langs.flatMap(lang =>
    countries.map(country => ({
      params: { lang, country: country.id },
      props: { country, lang },
    }))
  );
}

const { country, lang } = Astro.props as { country: typeof countries[0]; lang: Locale };
const popularCars = country.popularModels
  .map(id => cars.find(c => c.id === id))
  .filter(Boolean) as typeof cars;

const countryName = tData(country, 'name', lang);
const capitalName = tData(country, 'capital', lang);

const shippingTimeLabel = lang === 'zh' ? '运输时间' : lang === 'ru' ? 'Срок доставки' : 'Shipping Time';

const importStepsZh = [
  { step: 1, title: '选择车辆', desc: `浏览我们的目录，从 18+ 款可出口到${countryName}的中国车型中选择。我们将在 24 小时内提供详细的 CIF 报价。` },
  { step: 2, title: '确认订单与付款', desc: `签署形式发票并通过 T/T 银行电汇支付 30% 定金。我们将从授权经销商开始采购车辆。` },
  { step: 3, title: '质量检验', desc: `我们的团队进行全面的装船前检验，包括外观、内饰、机械系统和文件。提供照片和视频。` },
  { step: 4, title: '运输与文件', desc: `车辆从宁波/上海港口通过滚装船或集装箱运输。我们准备所有出口文件：提单、原产地证、商业发票、装箱单。` },
  { step: 5, title: '清关', desc: `到达${capitalName}港口后，我们的物流合作伙伴处理清关手续。进口关税：${country.importTax}。所有费用透明且提前报价。` },
  { step: 6, title: '交付与注册', desc: `车辆交付到您在${countryName}的指定地点。我们提供当地注册所需的所有文件。尾款（70%）在确认交付时支付。` },
];

const importStepsRu = [
  { step: 1, title: 'Выберите автомобиль', desc: `Просмотрите наш каталог и выберите из более чем 18 моделей китайских автомобилей, доступных для экспорта в ${countryName}. Мы предоставим подробный CIF расчёт в течение 24 часов.` },
  { step: 2, title: 'Подтверждение заказа и оплата', desc: `Подпишите счёт-проформу и внесите 30% предоплаты через банковский перевод T/T. Мы начнём закупку автомобиля у авторизованных дилеров.` },
  { step: 3, title: 'Контроль качества', desc: `Наша команда проводит всестороннюю инспекцию перед отгрузкой, включая внешний вид, интерьер, механические системы и документацию. Фото и видео предоставляются.` },
  { step: 4, title: 'Доставка и документация', desc: `Автомобиль отправляется из портов Нинбо/Шанхай через RORO или контейнер. Мы готовим все экспортные документы: коносамент, сертификат происхождения, коммерческий счёт-фактура, упаковочный лист.` },
  { step: 5, title: 'Таможенное оформление', desc: `По прибытии в порт ${capitalName} наш логистический партнёр занимается таможенным оформлением. Импортная пошлина: ${country.importTax}. Все сборы прозрачны и предварительно рассчитаны.` },
  { step: 6, title: 'Доставка и регистрация', desc: `Автомобиль доставлен по вашему адресу в ${countryName}. Мы предоставляем все документы для местной регистрации. Остаток (70%) оплачивается при подтверждении доставки.` },
];

const importStepsEn = [
  { step: 1, title: 'Select Your Vehicle', desc: `Browse our catalog and choose from 18+ Chinese car models available for export to ${countryName}. We'll provide a detailed CIF quote within 24 hours.` },
  { step: 2, title: 'Confirm Order & Payment', desc: `Sign the proforma invoice and make a 30% deposit via T/T bank transfer. We'll begin vehicle procurement from authorized dealers.` },
  { step: 3, title: 'Quality Inspection', desc: `Our team conducts a comprehensive pre-shipment inspection covering exterior, interior, mechanical systems, and documentation. Photos and video provided.` },
  { step: 4, title: 'Shipping & Documentation', desc: `Vehicle shipped via RORO or container from Ningbo/Shanghai port. We prepare all export documents: Bill of Lading, Certificate of Origin, Commercial Invoice, Packing List.` },
  { step: 5, title: 'Customs Clearance', desc: `Upon arrival at ${capitalName} port, our logistics partner handles customs clearance. Import duty: ${country.importTax}. All fees transparent and pre-quoted.` },
  { step: 6, title: 'Delivery & Registration', desc: `Vehicle delivered to your location in ${countryName}. We provide all documents needed for local registration. Balance payment (70%) due upon delivery confirmation.` },
];

const importSteps = lang === 'zh' ? importStepsZh : lang === 'ru' ? importStepsRu : importStepsEn;

const requiredDocsZh = [
  '提单（原件）',
  '商业发票（3份）',
  '装箱单',
  '原产地证（中国）',
  '车辆所有权证书',
  '出口报关单',
  '装船前检验证书',
  '排放合规证书（欧5/6）',
  `${countryName}进口申报单`,
  '保险单',
];

const requiredDocsRu = [
  'Коносамент (оригинал)',
  'Коммерческий счёт-фактура (3 копии)',
  'Упаковочный лист',
  'Сертификат происхождения (Китай)',
  'Свидетельство о праве собственности на автомобиль',
  'Экспортная декларация',
  'Сертификат инспекции перед отгрузкой',
  'Сертификат соответствия нормам выбросов (Евро 5/6)',
  `${countryName} Импортная декларация`,
  'Страховой сертификат',
];

const requiredDocsEn = [
  'Bill of Lading (Original)',
  'Commercial Invoice (3 copies)',
  'Packing List',
  'Certificate of Origin (China)',
  'Vehicle Title / Ownership Certificate',
  'Export Declaration Form',
  'Pre-Shipment Inspection Certificate',
  'Emission Compliance Certificate (Euro 5/6)',
  `${countryName} Import Declaration Form`,
  'Insurance Certificate',
];

const requiredDocs = lang === 'zh' ? requiredDocsZh : lang === 'ru' ? requiredDocsRu : requiredDocsEn;

const pageTitle = lang === 'zh'
  ? `如何从中国进口汽车到${countryName} — 2026完整指南 | NewAge Trading`
  : lang === 'ru'
  ? `Как импортировать авто из Китая в ${countryName} — Полное руководство 2026 | NewAge Trading`
  : `How to Import Cars from China to ${countryName} — Complete Guide 2026 | NewAge Trading`;

const pageDesc = lang === 'zh'
  ? `从中国进口汽车到${countryName}的完整指南。进口关税：${country.importTax}。运输 25-40 天。BYD、吉利、长城可供应。免费 CIF 报价。`
  : lang === 'ru'
  ? `Полное руководство по импорту китайских авто в ${countryName}. Импортная пошлина: ${country.importTax}. Доставка 25-40 дней. BYD, Geely, Great Wall. Бесплатный CIF расчёт.`
  : `Complete guide to importing Chinese cars to ${countryName}. Import duty: ${country.importTax}. Shipping 25-40 days. BYD, Geely, Great Wall available. Free CIF quote.`;

const heroH1 = lang === 'zh'
  ? `从中国进口汽车到${countryName}`
  : lang === 'ru'
  ? `Импорт авто из Китая в ${countryName}`
  : `Import Cars from China to ${countryName}`;

const importProcessLabel = lang === 'zh' ? '6步进口流程' : lang === 'ru' ? '6-этапный процесс импорта' : '6-Step Import Process';
const requiredDocsLabel = lang === 'zh' ? '所需文件' : lang === 'ru' ? 'Необходимые документы' : 'Required Documents';
const popularModelsLabel = lang === 'zh' ? `${countryName}热门车型` : lang === 'ru' ? `Популярные модели для ${countryName}` : `Popular Models for ${countryName}`;
const importDutiesLabel = lang === 'zh' ? `进口关税与税收 — ${countryName}` : lang === 'ru' ? `Импортные пошлины и налоги — ${countryName}` : `Import Duties & Taxes — ${countryName}`;
const keyTaxLabel = lang === 'zh' ? '📋 税务要点' : lang === 'ru' ? '📋 Ключевая налоговая информация' : '📋 Key Tax Information';
const regulationsLabel = lang === 'zh' ? '法规要求' : lang === 'ru' ? 'Нормативные требования' : 'Regulations';
const docsNote = lang === 'zh' ? '* 我们处理所有文件准备工作。您只需提供当地进口许可证和买方身份证明。' : lang === 'ru' ? '* Мы занимаемся подготовкой всей документации. Вам нужно предоставить только местную импортную лицензию и удостоверение покупателя.' : '* We handle all documentation preparation. You only need to provide your local import license and buyer identification.';

const faqItemsZh = [
  { question: `从中国进口汽车到${countryName}需要多少费用？`, answer: `总费用包括 FOB 价格（车辆成本）、海运费（$900–$2,400，视路线而定）、海运保险费（约车辆价值的 0.3%）和当地进口关税（${country.importTax}）。例如，比亚迪汉（FOB $32,999）的 CIF ${capitalName} 价格约为 $35,000–$37,000。请联系我们获取精确报价。` },
  { question: `从中国运输到${countryName}需要多长时间？`, answer: `从中国港口（宁波/上海）到${capitalName}的运输时间约为 25-40 天，视运输方式而定。滚装船通常需要 25-35 天，集装箱运输需要 30-40 天。我们提供全程实时跟踪。` },
  { question: `${countryName}的汽车进口规定是什么？`, answer: `${tData(country, 'regulations', lang)} 进口关税为 ${country.importTax}。${country.taxNotes} 所有车辆到达后必须通过技术检验。我们处理所有合规要求和文件。` },
  { question: `能向中国${countryName}进口电动车吗？`, answer: `可以，电动车在${countryName}越来越受欢迎。${country.taxNotes} ${countryName}的热门电动车型包括比亚迪汉、比亚迪海豹和比亚迪元 PLUS。电动车通常享受减免或零进口关税，性价比更高。` },
  { question: `出口到${countryName}的汽车有保修吗？`, answer: `所有车辆都带有制造商的标准保修。我们还通过服务网络提供延保方案。对于电动车电池，大多数制造商提供 6-8 年/15 万公里保修。我们可以在${countryName}为您联系授权服务中心（如可用）。` },
];

const faqItemsRu = [
  { question: `Сколько стоит импорт авто из Китая в ${countryName}?`, answer: `Общая стоимость включает цену FOB (стоимость автомобиля), морской фрахт ($900–$2,400 в зависимости от маршрута), морскую страховку (~0,3% от стоимости авто) и местные импортные пошлины (${country.importTax}). Например, BYD Han (FOB $32,999) будет стоить примерно $35,000–$37,000 CIF ${capitalName}. Свяжитесь с нами для точного расчёта.` },
  { question: `Сколько времени занимает доставка из Китая в ${countryName}?`, answer: `Доставка из китайских портов (Нинбо/Шанхай) в ${capitalName} занимает примерно 25–40 дней в зависимости от способа доставки. RORO обычно 25–35 дней, контейнерная доставка 30–40 дней. Мы предоставляем отслеживание в реальном времени.` },
  { question: `Каковы правила импорта автомобилей в ${countryName}?`, answer: `${tData(country, 'regulations', lang)} Импортная пошлина составляет ${country.importTax}. ${country.taxNotes} Все автомобили должны пройти техническую инспекцию по прибытии. Мы занимаемся всеми требованиями соответствия и документацией.` },
  { question: `Можно ли импортировать электромобиль в ${countryName}?`, answer: `Да, электромобили становятся всё более популярными в ${countryName}. ${country.taxNotes} Популярные модели EV для ${countryName} включают BYD Han, BYD Seal и BYD Atto 3. Электромобили часто пользуются сниженными или нулевыми импортными пошлинами.` },
  { question: `Предоставляете ли вы гарантию для авто, экспортируемых в ${countryName}?`, answer: `Все автомобили поставляются со стандартной гарантией производителя. Мы также предлагаем расширенные гарантии через нашу сервисную сеть. Для батарей EV большинство производителей предоставляют гарантию 6–8 лет / 150 000 км.` },
];

const faqItemsEn = [
  { question: `How much does it cost to import a car from China to ${countryName}?`, answer: `The total cost includes FOB price (vehicle cost), ocean freight ($900–$2,400 depending on route), marine insurance (~0.3% of vehicle value), and local import duties (${country.importTax}). For example, a BYD Han (FOB $32,999) would cost approximately $35,000–$37,000 CIF ${capitalName}. Contact us for an exact quote.` },
  { question: `How long does shipping from China to ${countryName} take?`, answer: `Shipping from Chinese ports (Ningbo/Shanghai) to ${capitalName} takes approximately 25–40 days depending on the shipping method. RORO (Roll-on/Roll-off) is typically 25–35 days, while container shipping takes 30–40 days. We provide real-time tracking throughout.` },
  { question: `What are the import regulations for cars in ${countryName}?`, answer: `${country.regulations} Import duty is ${country.importTax}. ${country.taxNotes} All vehicles must pass a technical inspection upon arrival. We handle all compliance requirements and documentation.` },
  { question: `Can I import an electric car to ${countryName}?`, answer: `Yes, electric vehicles (EVs) are increasingly popular in ${countryName}. ${country.taxNotes} Popular EV models for ${countryName} include BYD Han, BYD Seal, and BYD Atto 3. EVs often enjoy reduced or zero import duties, making them particularly cost-effective.` },
  { question: `Do you provide warranty for cars exported to ${countryName}?`, answer: `All vehicles come with the manufacturer's standard warranty. We also offer extended warranty packages through our service network. For EV batteries, most manufacturers provide 6–8 year / 150,000 km warranty. We can connect you with authorized service centers in ${countryName} where available.` },
];

const faqItems = lang === 'zh' ? faqItemsZh : lang === 'ru' ? faqItemsRu : faqItemsEn;
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  lang={lang}
  schema={{
    "@type": "HowTo",
    "name": heroH1,
    "description": pageDesc,
    "step": importSteps.map(s => ({
      "@type": "HowToStep",
      "name": s.title,
      "text": s.desc,
      "position": s.step
    }))
  }}
>
  <Breadcrumb crumbs={[
    { name: label('home', lang), path: `/${lang}/` },
    { name: label('cars', lang), path: `/${lang}/cars/` },
    { name: `${label('importGuide', lang)}: ${countryName}`, path: `/${lang}/cars/guide/${country.id}/` },
  ]} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#1e3a5f] to-[#2563eb] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-[#c4a35a] text-[#1e3a5f] px-4 py-1 rounded-full text-sm font-bold mb-4">{country.region}</span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{heroH1}</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-8">{tData(country, 'description', lang)}</p>
      <div class="flex flex-wrap justify-center gap-6">
        <div class="bg-white/10 rounded-lg px-6 py-4">
          <div class="text-sm text-gray-400">{label('importDuty', lang)}</div>
          <div class="text-xl font-bold text-[#c4a35a]">{country.importTax}</div>
        </div>
        <div class="bg-white/10 rounded-lg px-6 py-4">
          <div class="text-sm text-gray-400">{label('currency', lang)}</div>
          <div class="text-xl font-bold">{country.currency}</div>
        </div>
        <div class="bg-white/10 rounded-lg px-6 py-4">
          <div class="text-sm text-gray-400">{label('capital', lang)}</div>
          <div class="text-xl font-bold">{capitalName}</div>
        </div>
        <div class="bg-white/10 rounded-lg px-6 py-4">
          <div class="text-sm text-gray-400">{shippingTimeLabel}</div>
          <div class="text-xl font-bold">25–40 Days</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tax & Duty -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-[#1e3a5f] mb-8">{importDutiesLabel}</h2>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-8">
        <h3 class="font-bold text-lg text-amber-800 mb-2">{keyTaxLabel}</h3>
        <p class="text-amber-700">{country.taxNotes}</p>
      </div>
      <div class="bg-gray-50 rounded-xl p-6">
        <h3 class="font-bold text-lg text-[#1e3a5f] mb-2">{regulationsLabel}</h3>
        <p class="text-gray-700">{tData(country, 'regulations', lang)}</p>
      </div>
    </div>
  </section>

  <!-- Import Steps -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-[#1e3a5f] mb-12 text-center">{importProcessLabel}</h2>
      <div class="space-y-8">
        {importSteps.map(s => (
          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[#1e3a5f] text-white rounded-full flex items-center justify-center font-bold text-lg">{s.step}</div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-[#1e3a5f] mb-2">{s.title}</h3>
              <p class="text-gray-600 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Required Documents -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-[#1e3a5f] mb-8">{requiredDocsLabel}</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {requiredDocs.map((doc, i) => (
          <div class="flex items-center gap-3 bg-gray-50 rounded-lg px-4 py-3">
            <span class="text-[#c4a35a] font-bold">{i + 1}.</span>
            <span class="text-gray-700">{doc}</span>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-500 mt-6">{docsNote}</p>
    </div>
  </section>

  <!-- Popular Models for this Country -->
  {popularCars.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-[#1e3a5f] mb-8">{popularModelsLabel}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
          {popularCars.map(car => {
            const carName = tData(car, 'name', lang);
            const carCat = tData(car, 'category', lang);
            const carType = tData(car, 'type', lang);
            return (
              <a href={`/${lang}/cars/price/${car.id}/`} class="bg-white rounded-xl shadow-sm hover:shadow-lg transition-shadow p-6 text-center group">
                <div class="mb-3">
                  <img src={`/images/cars/${car.id}.jpg?v=20260514`} alt={carName} class="h-16 w-full object-contain mx-auto">
                </div>
                <h3 class="font-bold text-[#1e3a5f] group-hover:text-[#c4a35a] transition-colors">{carName}</h3>
                <p class="text-sm text-gray-500 mt-1">{carCat} • {carType}</p>
                <p class="text-[#c4a35a] font-bold mt-2 text-sm">{car.priceRange}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-[#1e3a5f] mb-8 text-center">{label('faq', lang)}</h2>
      <div class="space-y-4">
        {faqItems.map(item => (
          <details class="bg-gray-50 rounded-xl overflow-hidden group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-[#1e3a5f] hover:bg-gray-100 transition-colors flex justify-between items-center">
              {item.question}
              <span class="text-[#c4a35a] group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-6 pb-4 text-gray-600 leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      })} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
