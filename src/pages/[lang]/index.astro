---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ServiceCard from '@components/ServiceCard.astro';
import TrustBadges from '@components/TrustBadges.astro';
import FeaturedProducts from '@components/FeaturedProducts.astro';
import PartnerLogos from '@components/PartnerLogos.astro';
import LatestBlog from '@components/LatestBlog.astro';
import { t } from '@i18n/index';
import type { Locale } from '@i18n/types';
import { contact } from '@config/contact';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };

const trustItems = [
  { title: t('home.trustQuality', lang), description: t('home.trustQualityDesc', lang), icon: 'quality' as const },
  { title: t('home.trustLogistics', lang), description: t('home.trustLogisticsDesc', lang), icon: 'logistics' as const },
  { title: t('home.trustSupport', lang), description: t('home.trustSupportDesc', lang), icon: 'support' as const },
];

const indexSchema: Record<string, unknown> = {
  "@type": "Organization",
  "name": "YunBao International Trading",
  "url": "https://newage-trading.com",
  "logo": "https://newage-trading.com/images/logo.svg",
  "image": "https://newage-trading.com/images/og-default.svg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Beijing",
    "addressCountry": "China"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": `+${contact.whatsappNumber}`,
    "contactType": "sales",
    "availableLanguage": ["English", "Russian", "Chinese"]
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0",
        "currency": "USD"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "Worldwide"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 3,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 25,
          "maxValue": 35,
          "unitCode": "DAY"
        }
      }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
      "merchantReturnDays": null,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  }
};

const services = [
  {
    image: '/images/cars/byd-seal.jpg?v=20260526',
    imageAlt: { en: 'Chinese Car Export', ru: 'Экспорт автомобилей из Китая', zh: '中国汽车出口' }[lang] || 'Chinese Car Export',
    title: t('home.carsTitle', lang),
    description: t('home.carsDesc', lang),
    href: `/${lang}/cars/`,
  },
  {
    image: '/images/cars/mg4-ev.jpg?v=20260526',
    imageAlt: { en: 'Used Car Export to Africa', ru: 'Экспорт б/у авто в Африку', zh: '二手车出口非洲' }[lang] || 'Used Car Export to Africa',
    title: t('home.usedCarsTitle', lang),
    description: t('home.usedCarsDesc', lang),
    href: `/${lang}/used-cars/`,
  },
  {
    image: '/images/lingerie/silk.jpg?v=20260529',
    imageAlt: { en: 'Lingerie OEM Manufacturing', ru: 'OEM производство белья', zh: '内衣OEM代工' }[lang] || 'Lingerie OEM Manufacturing',
    title: t('home.lingerieTitle', lang),
    description: t('home.lingerieDesc', lang),
    href: `/${lang}/lingerie/`,
  },
  {
    image: '/images/security/hikvision-darkfighter.jpg?v=20260529',
    imageAlt: { en: 'Security Equipment Wholesale', ru: 'Оптовые продажи оборудования безопасности', zh: '安防设备批发' }[lang] || 'Security Equipment Wholesale',
    title: t('home.securityTitle', lang),
    description: t('home.securityDesc', lang),
    href: `/${lang}/security/`,
  },
];
---

<BaseLayout
  title={t('site.title', lang)}
  description={t('site.description', lang)}
  lang={lang}
  schema={indexSchema}
>
  <!-- Hero -->
  <Hero
    title={t('home.heroTitle', lang)}
    subtitle={t('home.heroSubtitle', lang)}
    ctaText={t('home.heroCTA', lang)}
    ctaLink={`/${lang}/contact/`}
    lang={lang}
  />

  <!-- Services Section -->
  <section class="container-section">
    <div class="text-center mb-12">
      <h2 class="section-title mb-4">{t('home.servicesTitle', lang)}</h2>
      <p class="section-subtitle">{t('home.servicesSubtitle', lang)}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map(service => (
        <ServiceCard
          image={service.image}
          imageAlt={service.imageAlt}
          title={service.title}
          description={service.description}
          href={service.href}
          ctaText={t('common.learnMore', lang)}
        />
      ))}
    </div>
  </section>

  <!-- Stats Section -->
  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-2xl font-bold text-accent mb-2">🚗</div>
          <div class="text-gray-400 text-sm">{lang === 'zh' ? '车辆出口' : lang === 'ru' ? 'Экспорт автомобилей' : 'Vehicle Export'}</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-accent mb-2">👗</div>
          <div class="text-gray-400 text-sm">{lang === 'zh' ? '内衣OEM/ODM' : lang === 'ru' ? 'Женское белье OEM/ODM' : 'Lingerie OEM/ODM'}</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-accent mb-2">🔒</div>
          <div class="text-gray-400 text-sm">{lang === 'zh' ? '安防设备' : lang === 'ru' ? 'Охранным оборудованием' : 'Security Equipment'}</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-accent mb-2">🌐</div>
          <div class="text-gray-400 text-sm">{lang === 'zh' ? '中国采购' : lang === 'ru' ? 'Закупки в Китае' : 'China-Based Sourcing'}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges
    title={t('home.trustTitle', lang)}
    subtitle={t('home.trustDesc', lang)}
    items={trustItems}
  />

  <!-- Featured Products -->
  <FeaturedProducts lang={lang} />

  <!-- Partners & Certifications -->
  <PartnerLogos lang={lang} />

  <!-- Latest Blog Posts -->
  <LatestBlog lang={lang} />
</BaseLayout>
