---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ServiceCard from '@components/ServiceCard.astro';
import TrustBadges from '@components/TrustBadges.astro';
import FeaturedProducts from '@components/FeaturedProducts.astro';
import Testimonials from '@components/Testimonials.astro';
import PartnerLogos from '@components/PartnerLogos.astro';
import LatestBlog from '@components/LatestBlog.astro';
import { t } from '@i18n/index';
import type { Locale } from '@i18n/types';
import { contact } from '@config/contact';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };

const trustItems = [
  { title: t('home.trustQuality', lang), description: t('home.trustQualityDesc', lang), icon: 'quality' as const },
  { title: t('home.trustLogistics', lang), description: t('home.trustLogisticsDesc', lang), icon: 'logistics' as const },
  { title: t('home.trustSupport', lang), description: t('home.trustSupportDesc', lang), icon: 'support' as const },
];

const indexSchema: Record<string, unknown> = {
  "@type": "Organization",
  "name": "YunBao International Trading",
  "url": "https://newage-trading.com",
  "logo": "https://newage-trading.com/images/logo.svg",
  "image": "https://newage-trading.com/images/og-default.svg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Beijing",
    "addressCountry": "China"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": `+${contact.whatsappNumber}`,
    "contactType": "sales",
    "availableLanguage": ["English", "Russian", "Chinese"]
  },
  "makesOffer": [
    {
      "@type": "Service",
      "serviceType": "Vehicle Export & Procurement",
      "areaServed": ["Georgia", "Ghana", "Nigeria", "Kenya"]
    },
    {
      "@type": "Service",
      "serviceType": "Lingerie OEM/ODM",
      "areaServed": "Worldwide"
    }
  ]
};

// Primary CTA: Vehicle Export (new + used combined)
const primaryServices = [
  {
    image: '/images/cars/byd-seal.jpg?v=20260526',
    imageAlt: { en: 'New Car Export', ru: 'Экспорт новых автомобилей', zh: '新车出口' }[lang] || 'New Car Export',
    title: t('home.carsTitle', lang),
    description: t('home.carsDesc', lang),
    href: `/${lang}/cars/`,
  },
  {
    image: '/images/cars/mg4-ev.jpg?v=20260526',
    imageAlt: { en: 'Used Car Export to Africa', ru: 'Экспорт б/у авто в Африку', zh: '二手车出口非洲' }[lang] || 'Used Car Export to Africa',
    title: t('home.usedCarsTitle', lang),
    description: t('home.usedCarsDesc', lang),
    href: `/${lang}/used-cars/`,
  },
];

// Secondary: Lingerie OEM
const secondaryServices = [
  {
    image: '/images/lingerie/silk.jpg?v=20260529',
    imageAlt: { en: 'Lingerie OEM Manufacturing', ru: 'OEM производство белья', zh: '内衣OEM代工' }[lang] || 'Lingerie OEM Manufacturing',
    title: t('home.lingerieTitle', lang),
    description: t('home.lingerieDesc', lang),
    href: `/${lang}/lingerie/`,
  },
];

// Other: Security (not promoted in hero or primary CTA)
const otherServices = [
  {
    image: '/images/security/hikvision-darkfighter.jpg?v=20260529',
    imageAlt: { en: 'Security Equipment Wholesale', ru: 'Оптовые продажи оборудования безопасности', zh: '安防设备批发' }[lang] || 'Security Equipment Wholesale',
    title: t('home.securityTitle', lang),
    description: t('home.securityDesc', lang),
    href: `/${lang}/security/`,
  },
];
---

<BaseLayout
  title={t('site.title', lang)}
  description={t('site.description', lang)}
  lang={lang}
  schema={indexSchema}
>
  <!-- Hero -->
  <Hero
    title={t('home.heroTitle', lang)}
    subtitle={t('home.heroSubtitle', lang)}
    ctaText={t('home.heroCTA', lang)}
    ctaLink={`/${lang}/cars/`}
    lang={lang}
  />

  <!-- Primary Services: Vehicle Export -->
  <section class="container-section">
    <div class="text-center mb-12">
      <h2 class="section-title mb-4">{t('home.servicesTitle', lang)}</h2>
      <p class="section-subtitle">{t('home.servicesSubtitle', lang)}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {primaryServices.map(service => (
        <ServiceCard
          image={service.image}
          imageAlt={service.imageAlt}
          title={service.title}
          description={service.description}
          href={service.href}
          ctaText={t('common.learnMore', lang)}
        />
      ))}
    </div>
  </section>

  <!-- Secondary: Lingerie OEM -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="section-title mb-4">{t('home.lingerieTitle', lang)}</h2>
        <p class="section-subtitle">{t('home.lingerieDesc', lang)}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {secondaryServices.map(service => (
          <ServiceCard
            image={service.image}
            imageAlt={service.imageAlt}
            title={service.title}
            description={service.description}
            href={service.href}
            ctaText={t('common.learnMore', lang)}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Other Services (Security) -->
  <section class="container-section">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">{t('home.securityTitle', lang)}</h2>
      <p class="text-gray-600">{t('home.securityDesc', lang)}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {otherServices.map(service => (
        <ServiceCard
          image={service.image}
          imageAlt={service.imageAlt}
          title={service.title}
          description={service.description}
          href={service.href}
          ctaText={t('common.learnMore', lang)}
        />
      ))}
    </div>
  </section>

  <!-- Capabilities Section -->
  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-lg font-semibold text-accent mb-2">{t('about.clients', lang)}</div>
        </div>
        <div>
          <div class="text-lg font-semibold text-accent mb-2">{t('about.countries', lang)}</div>
        </div>
        <div>
          <div class="text-lg font-semibold text-accent mb-2">{t('about.years', lang)}</div>
        </div>
        <div>
          <div class="text-lg font-semibold text-accent mb-2">{t('about.products', lang)}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges
    title={t('home.trustTitle', lang)}
    subtitle={t('home.trustDesc', lang)}
    items={trustItems}
  />

  <!-- Featured Products -->
  <FeaturedProducts lang={lang} />

  <!-- Testimonials -->
  <Testimonials lang={lang} />

  <!-- Partners & Certifications -->
  <PartnerLogos lang={lang} />

  <!-- Latest Blog Posts -->
  <LatestBlog lang={lang} />
</BaseLayout>
