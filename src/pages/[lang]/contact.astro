---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { t } from '@i18n/index';
import type { Locale } from '@i18n/types';
import { contact, isWhatsAppConfigured } from '@config/contact';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };

const formActionUrl = '/api/contact';

const contactSchema: Record<string, unknown> = {
  "@type": "ContactPage",
  "name": "Contact Us",
  "url": `https://newage-trading.com/${lang}/contact/`,
  "publisher": {
    "@type": "Organization",
    "name": "YunBao International Trading",
    "email": contact.email,
    "url": "https://newage-trading.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Beijing",
      "addressCountry": "China"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": `+${contact.whatsappNumber}`,
      "contactType": "sales",
      "availableLanguage": ["English", "Russian", "Chinese"]
    }
  }
};

const contactMethods = [
  {
    label: t('contact.whatsapp', lang),
    value: contact.whatsappDisplay,
    href: `https://wa.me/${contact.whatsappNumber}`,
    icon: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z',
  },
  {
    label: t('contact.telegram', lang),
    value: contact.telegram,
    href: contact.telegramUrl,
    icon: 'M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  },
  {
    label: t('contact.email', lang),
    value: contact.email,
    href: `mailto:${contact.email}`,
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
];
---

<BaseLayout
  title={t('contact.title', lang)}
  description={t('contact.subtitle', lang)}
  lang={lang}
  schema={contactSchema}
>
  <Breadcrumb crumbs={[
    { name: t('nav.home', lang), path: `/${lang}/` },
    { name: t('nav.contact', lang), path: `/${lang}/contact/` },
  ]} />

  <section class="bg-primary py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">{t('contact.title', lang)}</h1>
      <p class="text-xl text-gray-300">{t('contact.subtitle', lang)}</p>
    </div>
  </section>

  <section class="container-section">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div>
        <h2 class="text-2xl font-bold mb-2">{t('contact.formTitle', lang)}</h2>
        <p class="text-gray-600 mb-6 text-sm">{lang === 'zh' ? '请选择您的业务类型，以便我们更好地为您服务。' : lang === 'ru' ? 'Выберите тип вашего бизнеса для более точного обслуживания.' : 'Please select your business type to help us serve you better.'}</p>

        <!-- Business Line Selector -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-primary mb-2">{lang === 'zh' ? '业务类型 *' : lang === 'ru' ? 'Тип бизнеса *' : 'Business Type *'}</label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" id="btnVehicle" class="biz-btn px-4 py-3 rounded-lg border-2 border-accent bg-accent/10 text-accent font-semibold text-center" onclick="selectBiz('vehicle')">
              🚗 {lang === 'zh' ? '汽车出口' : lang === 'ru' ? 'Экспорт автомобилей' : 'Vehicle Export'}
            </button>
            <button type="button" id="btnLingerie" class="biz-btn px-4 py-3 rounded-lg border-2 border-gray-300 text-gray-600 font-semibold text-center" onclick="selectBiz('lingerie')">
              👗 {lang === 'zh' ? '内衣OEM' : lang === 'ru' ? 'Одежда для белья OEM' : 'Lingerie OEM'}
            </button>
          </div>
        </div>

        <form id="contactForm" class="space-y-4" action={formActionUrl} method="POST">
          <!-- Hidden fields for tracking -->
          <input type="hidden" name="_subject" value="New Contact Form Submission — YunBao International Trading" />
          <input type="hidden" name="_lang" value={lang} />
          <input type="hidden" name="_business_line" id="fieldBizLine" value="" />
          <input type="hidden" name="_source_page" id="fieldSourcePage" value="" />
          <input type="hidden" name="_lead_id" id="fieldLeadId" value="" />
          <!-- Honeypot field (anti-spam) -->
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

          <!-- Vehicle Export Fields -->
          <div id="vehicleFields" class="biz-fields">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Destination Country *</label>
                <input type="text" name="destination_country" placeholder="e.g. Georgia, Ghana" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Destination Port</label>
                <input type="text" name="destination_port" placeholder="e.g. Poti, Tema" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-primary mb-1">Service Type *</label>
              <select name="service_type" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none">
                <option value="">-- Select --</option>
                <option value="procurement_and_export">Procurement + Export</option>
                <option value="export_only">Already Have Vehicle — Export Only</option>
              </select>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Brand / Model</label>
                <input type="text" name="vehicle_model" placeholder="e.g. BYD Seal, Toyota Camry" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Year Range</label>
                <input type="text" name="vehicle_year" placeholder="e.g. 2022-2024" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Quantity</label>
                <input type="text" name="quantity" placeholder="e.g. 1, 5, 10+" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Budget / Target Cost</label>
                <input type="text" name="budget" placeholder="e.g. $15,000-20,000 per unit" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-primary mb-1">Expected Purchase Timeline</label>
              <select name="timeline" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none">
                <option value="">-- Select --</option>
                <option value="immediate">Immediate (within 1 week)</option>
                <option value="1_month">Within 1 month</option>
                <option value="3_months">Within 3 months</option>
                <option value="exploring">Just exploring / no timeline yet</option>
              </select>
            </div>
          </div>

          <!-- Lingerie OEM Fields -->
          <div id="lingerieFields" class="biz-fields hidden">
            <div>
              <label class="block text-sm font-medium text-primary mb-1">Product Type *</label>
              <input type="text" name="product_type" placeholder="e.g. Seamless underwear, Lace bra, Sports bra" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Estimated Quantity / MOQ</label>
                <input type="text" name="estimated_qty" placeholder="e.g. 500 pcs, 1000 pcs" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Target Market</label>
                <input type="text" name="target_market" placeholder="e.g. Russia, EU, Africa" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-primary mb-1">Services Needed</label>
              <div class="grid grid-cols-2 gap-2 mt-1">
                <label class="flex items-center"><input type="checkbox" name="services" value="design" class="mr-2" /> Design support</label>
                <label class="flex items-center"><input type="checkbox" name="services" value="sampling" class="mr-2" /> Sampling</label>
                <label class="flex items-center"><input type="checkbox" name="services" value="fabric_advice" class="mr-2" /> Fabric advice</label>
                <label class="flex items-center"><input type="checkbox" name="services" value="full_production" class="mr-2" /> Full production</label>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Target Price Range</label>
                <input type="text" name="target_price" placeholder="e.g. $3-5 per unit" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Timeline</label>
                <input type="text" name="lingerie_timeline" placeholder="e.g. Q4 2026" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
            </div>
          </div>

          <!-- Common Fields -->
          <div class="border-t pt-4 mt-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-primary mb-1">{t('contact.formName', lang)} *</label>
                <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-primary mb-1">Company (optional)</label>
                <input type="text" name="company" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-primary mb-1">{t('contact.formEmail', lang)} *</label>
                <input type="email" name="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-primary mb-1">{t('contact.formPhone', lang)} / WhatsApp</label>
                <input type="tel" name="phone" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-primary mb-1">{t('contact.formMessage', lang)} *</label>
              <textarea name="message" rows={4} required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none" placeholder="Any additional details, specific requirements, or questions..."></textarea>
            </div>
          </div>

          <!-- Privacy Notice -->
          <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
            <p>By submitting this form, you agree that we may contact you regarding your inquiry via email, WhatsApp, or Telegram. We will not share your information with third parties. See our <a href={`/${lang}/privacy/`} class="text-accent underline">Privacy Policy</a>.</p>
          </div>

          <button type="submit" id="submitBtn" class="btn-primary w-full">{t('contact.formSubmit', lang)}</button>
          <div id="formStatus" class="hidden text-center py-3 px-4 rounded-lg"></div>
        </form>

        <script>
          // Business line selection
          let selectedBiz = '';
          function selectBiz(type) {
            selectedBiz = type;
            document.getElementById('fieldBizLine').value = type;
            document.getElementById('btnVehicle').className = type === 'vehicle'
              ? 'biz-btn px-4 py-3 rounded-lg border-2 border-accent bg-accent/10 text-accent font-semibold text-center'
              : 'biz-btn px-4 py-3 rounded-lg border-2 border-gray-300 text-gray-600 font-semibold text-center';
            document.getElementById('btnLingerie').className = type === 'lingerie'
              ? 'biz-btn px-4 py-3 rounded-lg border-2 border-accent bg-accent/10 text-accent font-semibold text-center'
              : 'biz-btn px-4 py-3 rounded-lg border-2 border-gray-300 text-gray-600 font-semibold text-center';
            document.getElementById('vehicleFields').classList.toggle('hidden', type !== 'vehicle');
            document.getElementById('lingerieFields').classList.toggle('hidden', type !== 'lingerie');
          }
          // Default to vehicle
          selectBiz('vehicle');

          // Set source page and lead ID
          document.getElementById('fieldSourcePage').value = window.location.pathname;
          document.getElementById('fieldLeadId').value = 'lead_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);

          // Self-hosted AJAX submission
          document.getElementById('contactForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const btn = document.getElementById('submitBtn');
            const status = document.getElementById('formStatus');
            const originalText = btn.textContent;
            const lang = document.documentElement.lang || 'en';

            if (!selectedBiz) {
              status.classList.remove('hidden');
              status.classList.add('bg-yellow-50', 'text-yellow-700');
              status.textContent = lang === 'zh' ? '请选择业务类型（汽车出口或内衣OEM）。' : lang === 'ru' ? 'Выберите тип бизнеса (Экспорт автомобилей или Одежда для белья OEM).' : 'Please select a business type (Vehicle Export or Lingerie OEM).';
              return;
            }

            btn.disabled = true;
            btn.textContent = '...';
            status.classList.add('hidden');

            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(data),
              });

              if (res.ok) {
                status.classList.remove('hidden');
                status.classList.add('bg-green-50', 'text-green-700');
                status.textContent = lang === 'zh' ? '✅ 询盘已提交！我们将在24小时内回复您。' : lang === 'ru' ? '✅ Запрос отправлен! Мы ответим вам в течение 24 часов.' : '✅ Inquiry submitted! We will get back to you within 24 hours.';
                form.reset();
                selectBiz('vehicle');
              } else {
                const errData = await res.json().catch(() => ({}));
                status.classList.remove('hidden');
                status.classList.add('bg-red-50', 'text-red-700');
                status.textContent = errData.error || (lang === 'zh' ? '发送失败，请稍后重试' : lang === 'ru' ? 'Ошибка отправки' : 'Failed to send. Please try again later.');
              }
            } catch (err) {
              status.classList.remove('hidden');
              status.classList.add('bg-red-50', 'text-red-700');
              status.textContent = lang === 'zh' ? '网络错误，请稍后重试' : lang === 'ru' ? 'Ошибка сети' : 'Network error. Please try again later.';
            } finally {
              btn.disabled = false;
              btn.textContent = originalText;
            }
          });
        </script>
      </div>

      <!-- Contact Info -->
      <div>
        <h2 class="text-2xl font-bold mb-6">{t('contact.infoTitle', lang)}</h2>
        <div class="space-y-6">
          {contactMethods.map(method => (
            <a
              href={method.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center p-4 rounded-xl bg-surface hover:bg-surface-dark transition-colors group"
            >
              <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mr-4 group-hover:bg-accent/20 transition-colors">
                <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 24 24">
                  <path d={method.icon} />
                </svg>
              </div>
              <div>
                <p class="text-sm text-muted">{method.label}</p>
                <p class="font-medium text-primary group-hover:text-accent transition-colors">{method.value}</p>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 p-6 rounded-xl bg-primary text-white">
          <p class="text-sm text-gray-400">{t('contact.responseTime', lang)}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
