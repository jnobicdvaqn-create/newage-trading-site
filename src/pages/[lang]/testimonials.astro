---
import BaseLayout from '@layouts/BaseLayout.astro';
import { label } from '@lib/i18n-data';
import type { Locale } from '@i18n/types';
import testimonials from '../../data/testimonials.json';

export interface Props {
  lang: string;
}

const { lang = 'en' } = Astro.props;

export async function getStaticPaths() {
  const locales = ['en', 'zh', 'ru'] as const;
  return locales.map((lang) => ({ params: { lang } }));
}
---

<BaseLayout 
  lang={lang}
  title={label('testimonialsTitle', lang as Locale)}
  description={label('testimonialsDesc', lang as Locale)}
>
  <section class="relative py-20 bg-gradient-to-br from-[#0a1628] to-[#1e3a5f]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
          {label('testimonialsTitle', lang as Locale)}
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          {label('testimonialsSubtitle', lang as Locale)}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {testimonials.testimonials.map((testimonial) => (
          <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-[var(--color-primary)] flex items-center justify-center text-white font-bold text-lg">
                {testimonial.name.charAt(0)}
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">{testimonial.name}</h3>
                <p class="text-sm text-gray-500">{testimonial.location} · {testimonial.business}</p>
              </div>
            </div>
            
            <div class="flex mb-3">
              {Array.from({ length: testimonial.rating }).map((_, i) => (
                <svg class="w-5 h-5 text-[var(--color-accent)]" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            
            <blockquote class="text-gray-700 leading-relaxed mb-4">
              "{testimonial.quote}"
            </blockquote>
            
            <div class="pt-4 border-t border-gray-100">
              <p class="text-sm text-gray-500">
                <span class="font-medium">{testimonial.vehicle || testimonial.product}</span>
                <span class="mx-2">·</span>
                <span>{testimonial.date}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
---
