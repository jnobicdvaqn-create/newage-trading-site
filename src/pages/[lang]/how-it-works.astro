---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { t } from '@i18n/index';
import type { Locale } from '@i18n/types';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };

const schema: Record<string, unknown> = {
  "@type": "WebPage",
  "name": "How Quotes, Inspection & Secure Payment Work",
  "description": "Transparent process for vehicle procurement, export, inspection, and payment with YunBao International Trading.",
  "url": `https://newage-trading.com/${lang}/how-it-works/`,
  "publisher": {
    "@type": "Organization",
    "name": "YunBao International Trading",
    "url": "https://newage-trading.com"
  }
};
---

<BaseLayout
  title="How Quotes, Inspection & Secure Payment Work | YunBao International"
  description="Our transparent process: from inquiry to delivery. Learn how we handle vehicle procurement, quality inspection, export documentation, and secure payment."
  lang={lang}
  schema={schema}
>
  <Breadcrumb crumbs={[
    { name: t('nav.home', lang), path: `/${lang}/` },
    { name: 'How It Works', path: `/${lang}/how-it-works/` },
  ]} />

  <section class="bg-primary py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">How Quotes, Inspection &amp; Secure Payment Work</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Transparent process from inquiry to delivery. No hidden fees, no surprises.
      </p>
    </div>
  </section>

  <!-- Step 1: Inquiry -->
  <section class="container-section">
    <div class="flex items-start gap-6 mb-12">
      <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold flex-shrink-0">1</div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Inquiry &amp; Requirements Confirmation</h2>
        <p class="text-gray-600 mb-4">
          Tell us what you need: vehicle model, year, quantity, destination country/port, budget range, and timeline.
          The more details you provide, the more accurate our quotation will be.
        </p>
        <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
          <p><strong>What we need from you:</strong></p>
          <ul class="mt-2 space-y-1 ml-4 list-disc">
            <li>Vehicle brand, model, and preferred year range</li>
            <li>Quantity (single unit or fleet order)</li>
            <li>Destination country and port</li>
            <li>Budget or target cost per unit</li>
            <li>Expected purchase timeline</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Step 2: Candidate Vehicles -->
    <div class="flex items-start gap-6 mb-12">
      <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold flex-shrink-0">2</div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Candidate Vehicle / Sample Proposal</h2>
        <p class="text-gray-600 mb-4">
          Based on your requirements, we source available vehicles from our dealer network and provide you with:
        </p>
        <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
          <ul class="space-y-1 ml-4 list-disc">
            <li>Vehicle specifications, photos, and condition details</li>
            <li>Available colors, trims, and options</li>
            <li>Current market price range and availability</li>
            <li>Alternative options if your preferred model is unavailable</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Step 3: Quotation -->
    <div class="flex items-start gap-6 mb-12">
      <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold flex-shrink-0">3</div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Quotation, Validity &amp; Cost Boundaries</h2>
        <p class="text-gray-600 mb-4">
          We provide a detailed quotation with clear pricing terms. All quotations specify:
        </p>
        <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
          <p><strong>Quotation includes:</strong></p>
          <ul class="mt-2 space-y-1 ml-4 list-disc">
            <li><strong>Price term:</strong> EXW (Ex Works), FOB (Free on Board), or CIF (Cost, Insurance, Freight) — specified clearly</li>
            <li><strong>Vehicle cost:</strong> per unit price based on confirmed specification</li>
            <li><strong>Shipping cost:</strong> RORO or container, to your specified port</li>
            <li><strong>Insurance:</strong> marine cargo insurance (if CIF)</li>
            <li><strong>Documentation:</strong> export documents, certificate of origin</li>
            <li><strong>Validity period:</strong> typically 7-14 days (prices may change with exchange rates)</li>
          </ul>
          <p class="mt-3 text-yellow-700"><strong>Not included (unless specified):</strong> destination customs duties, import taxes, local clearance fees, vehicle registration.</p>
        </div>
      </div>
    </div>

    <!-- Step 4: PI / Contract -->
    <div class="flex items-start gap-6 mb-12">
      <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold flex-shrink-0">4</div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Proforma Invoice / Contract &amp; Payment Milestones</h2>
        <p class="text-gray-600 mb-4">
          Once you confirm the quotation, we issue a Proforma Invoice (PI) or sales contract with:
        </p>
        <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
          <ul class="space-y-1 ml-4 list-disc">
            <li>Exact vehicle specification and quantity</li>
            <li>Agreed price and payment terms</li>
            <li>Payment milestones (deposit balance)</li>
            <li>Delivery timeline and shipping method</li>
            <li>Both parties' legal information</li>
          </ul>
          <p class="mt-3 text-yellow-700"><strong>Important:</strong> We do not publish fixed payment percentages online. Payment terms are agreed per transaction and documented in the PI/contract.</p>
        </div>
      </div>
    </div>

    <!-- Step 5: Inspection -->
    <div class="flex items-start gap-6 mb-12">
      <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold flex-shrink-0">5</div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Vehicle Inspection, Quality Check &amp; Loading</h2>
        <p class="text-gray-600 mb-4">
          Before shipment, we verify:
        </p>
        <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
          <ul class="space-y-1 ml-4 list-disc">
            <li>Vehicle matches ordered specification (model, color, trim, VIN)</li>
            <li>Condition documentation with photos</li>
            <li>Mileage confirmation (for used vehicles)</li>
            <li>Proper loading and securing on vessel</li>
            <li>Loading photos provided to buyer</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Step 6: Documentation -->
    <div class="flex items-start gap-6 mb-12">
      <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold flex-shrink-0">6</div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Shipping &amp; Documentation</h2>
        <p class="text-gray-600 mb-4">
          After loading, we provide:
        </p>
        <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
          <ul class="space-y-1 ml-4 list-disc">
            <li>Bill of Lading (B/L)</li>
            <li>Commercial Invoice</li>
            <li>Packing List</li>
            <li>Certificate of Origin</li>
            <li>Export customs declaration</li>
            <li>Insurance certificate (if CIF)</li>
          </ul>
          <p class="mt-3">Original documents are sent to you via courier for customs clearance at destination.</p>
        </div>
      </div>
    </div>

    <!-- Step 7: Compliance -->
    <div class="flex items-start gap-6 mb-12">
      <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold flex-shrink-0">7</div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Compliance &amp; Destination Requirements</h2>
        <p class="text-gray-600 mb-4">
          <strong>Important:</strong> Import regulations, duties, and vehicle standards vary by country. It is the buyer's responsibility to:
        </p>
        <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
          <ul class="space-y-1 ml-4 list-disc">
            <li>Verify import eligibility (age limits, emission standards, etc.)</li>
            <li>Arrange customs clearance at destination port</li>
            <li>Pay applicable import duties and taxes</li>
            <li>Complete vehicle registration locally</li>
          </ul>
          <p class="mt-3 text-yellow-700">We can provide guidance based on our experience, but we do not guarantee clearance or delivery to any specific country. Always verify with your local customs agent.</p>
        </div>
      </div>
    </div>

    <!-- Step 8: After-sales -->
    <div class="flex items-start gap-6">
      <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-xl font-bold flex-shrink-0">8</div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-3">After-Sales Boundary</h2>
        <p class="text-gray-600 mb-4">
          Our service scope and after-sales support:
        </p>
        <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
          <p><strong>We provide:</strong></p>
          <ul class="mt-2 space-y-1 ml-4 list-disc">
            <li>Post-delivery support for documentation issues</li>
            <li>Assistance with warranty claims (manufacturer-dependent)</li>
            <li>Parts sourcing support where available</li>
          </ul>
          <p class="mt-3"><strong>We do not provide:</strong></p>
          <ul class="mt-1 space-y-1 ml-4 list-disc">
            <li>Local warranty service in destination country</li>
            <li>Vehicle repair or maintenance</li>
            <li>Guaranteed parts availability for all models</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
      <p class="text-gray-200 mb-8">
        Send us your requirements and we'll provide a detailed quotation within 24 hours.
      </p>
      <a href={`/${lang}/contact/`} class="btn-primary bg-accent text-primary hover:bg-accent/90">
        Request a Quote
      </a>
    </div>
  </section>
</BaseLayout>
